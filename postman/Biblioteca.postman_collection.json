  "item": [
    {
      "name": "01 · Registro público",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/registro",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Estudiante\",\n  \"email\": \"{{correoUsuario}}\",\n  \"clave\": \"Clave-Academica-2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const sufijo = Date.now().toString() + Math.floor(Math.random() * 1000).toString().padStart(3, \"0\");",
              "const baseIsbn = \"978\" + sufijo.slice(-9);",
              "const suma = [...baseIsbn].reduce((total, cifra, i) => total + Number(cifra) * (i % 2 ? 3 : 1), 0);",
              "pm.collectionVariables.set(\"isbn\", baseIsbn + ((10 - suma % 10) % 10));",
              "pm.collectionVariables.set(\"correoUsuario\", \"estudiante-\" + sufijo + \"@universidad.test\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Guarda id\", () => { const valor = pm.response.json().id; pm.expect(valor).to.exist; pm.collectionVariables.set(\"usuarioId\", valor); });",
              "pm.test(\"Rol asignado\", () => { pm.expect(pm.response.json().roles).to.eql([\"USUARIO\"]); });",
              "pm.test(\"Respuesta sin contraseña\", () => { pm.expect(pm.response.json()).not.to.have.property('claveHash'); });"
            ]
          }
        }
      ]
    },
